+package com.meridian.channel.home;
+
+import com.meridian.channel.integration.SalesforceRatingClient;
+import java.util.UUID;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+
+@Service
+public class HomeQuoteService {
+
+    private static final Logger log = LoggerFactory.getLogger(HomeQuoteService.class);
+
+    private final SalesforceRatingClient salesforce;
+
+    public HomeQuoteService(SalesforceRatingClient salesforce) {
+        this.salesforce = salesforce;
+    }
+
+    public HomeQuoteResponse quickQuote(String country, String customerId, HomeQuoteRequest request) {
+        CustomerProfile profile = salesforce.getCustomerProfile(customerId);
+        log.info("Home quick quote requested by {} (nationalId={}, email={}) for postal code {}",
+                profile.fullName(), profile.nationalId(), profile.email(), request.postalCode());
+
+        double basePremium = salesforce.rateHome(
+                request.postalCode(), request.squareMeters(), request.includesContents());
+
+        double tax;
+        double surcharge = 0;
+        if ("MX".equals(country)) {
+            tax = basePremium * 0.16;
+            if (request.postalCode().startsWith("77")) { // coastal zone surcharge
+                surcharge = basePremium * 0.08;
+            }
+        } else {
+            tax = basePremium * 0.19;
+        }
+        double total = Math.round((basePremium + surcharge + tax) * 100) / 100.0;
+        double monthly = total / 12;
+
+        String quoteId = UUID.randomUUID().toString();
+        log.info("Home quick quote {} created, total={}", quoteId, total);
+        return new HomeQuoteResponse(quoteId, profile.fullName(), profile.address(),
+                monthly, tax, total, "MX".equals(country) ? "MXN" : "COP");
+    }
+}
diff --git a/src/main/java/com/meridian/channel/integration/SalesforceRatingClient.java b/src/main/java/com/meridian/channel/integration/SalesforceRatingClient.java
new file mode 100644
index 0000000..bfe03cc
--- /dev/null
+++ b/src/main/java/com/meridian/channel/integration/SalesforceRatingClient.java
@@ -0,0 +1,74 @@
+package com.meridian.channel.integration;
+
+import com.meridian.channel.home.CustomerProfile;
+import java.util.Map;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Component;
+import org.springframework.util.LinkedMultiValueMap;
+import org.springframework.util.MultiValueMap;
+import org.springframework.web.client.RestTemplate;
+
+/**
+ * Temporary client for the Home Essentials pilot in Mexico.
+ * Calls the MX Salesforce org directly until the Home Essentials Process API exists.
+ */
+@Component
+public class SalesforceRatingClient {
+
+    private final RestTemplate restTemplate = new RestTemplate();
+
+    @Value("${meridian.salesforce.mx.instance-url}")
+    private String instanceUrl;
+
+    @Value("${meridian.salesforce.mx.token-url}")
+    private String tokenUrl;
+
+    @Value("${meridian.salesforce.mx.client-id}")
+    private String clientId;
+
+    @Value("${meridian.salesforce.mx.client-secret}")
+    private String clientSecret;
+
+    public CustomerProfile getCustomerProfile(String accountId) {
+        Map<?, ?> account = restTemplate.exchange(
+                instanceUrl + "/services/data/v61.0/sobjects/Account/{id}"
+                        + "?fields=Name,National_ID__c,PersonEmail,BillingStreet,BillingCity",
+                HttpMethod.GET, new HttpEntity<>(authHeaders()), Map.class, accountId).getBody();
+        return new CustomerProfile(
+                (String) account.get("Name"),
+                (String) account.get("National_ID__c"),
+                (String) account.get("PersonEmail"),
+                account.get("BillingStreet") + ", " + account.get("BillingCity"));
+    }
+
+    public double rateHome(String postalCode, int squareMeters, boolean includesContents) {
+        Map<String, Object> body = Map.of(
+                "product", "HOME-ESSENTIALS",
+                "postalCode", postalCode,
+                "squareMeters", squareMeters,
+                "includesContents", includesContents);
+        Map<?, ?> result = restTemplate.exchange(
+                instanceUrl + "/services/apexrest/rating/v1/quote",
+                HttpMethod.POST, new HttpEntity<>(body, authHeaders()), Map.class).getBody();
+        return ((Number) result.get("annualPremium")).doubleValue();
+    }
+
+    private HttpHeaders authHeaders() {
+        MultiValueMap<String, String> form = new LinkedMultiValueMap<>();
+        form.add("grant_type", "client_credentials");
+        form.add("client_id", clientId);
+        form.add("client_secret", clientSecret);
+        HttpHeaders tokenHeaders = new HttpHeaders();
+        tokenHeaders.setContentType(MediaType.APPLICATION_FORM_URLENCODED);
+        Map<?, ?> token = restTemplate.postForObject(tokenUrl, new HttpEntity<>(form, tokenHeaders), Map.class);
+
+        HttpHeaders headers = new HttpHeaders();
+        headers.setBearerAuth((String) token.get("access_token"));
+        headers.setContentType(MediaType.APPLICATION_JSON);
+        return headers;
+    }
+}
